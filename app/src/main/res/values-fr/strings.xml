        <item>@string/security_tips15</item>
    </string-array>
    <string name="security_tips01">Utilisez un clavier qui respecte votre liberté et ne se connecte pas à l\'internet, nous recommandons d\'utiliser OpenBoard</string>
    <string name="security_tips02">Votre sécurité dépend fortement des applications
        installées sur l\'appareil, nous recommandons de changer vos applications par défaut en applications du
        dépôt f-droid</string>
    <string name="security_tips03">Essayez de ne pas coller accidentellement l\'adresse de votre ami dans votre
        navigateur car cela pourrait mettre en péril votre/anonymat</string>
    <string name="security_tips04">Désinstallez Ghost Messenger pour supprimer votre compte et effacer
        tout.</string>
    <string name="security_tips05">Le téléchargement depuis notre service onion est plus sécurisé que nos
        serveurs clear net.</string>
    <string name="security_tips06">Le chiffrement de votre stockage de données n\'est sûr que tant que votre
        mot de passe, nous recommandons un long mot de passe composé de mots qui ne signifient rien pour vous.</string>
    <string name="security_tips07">Le texte est plus sûr et anonyme que tout autre chose.</string>
    <string name="security_tips08">Partagez votre adresse de la façon la plus sûre possible.</string>
    <string name="security_tips09">Chiffrez le stockage du téléphone si possible.</string>
    <string name="security_tips10">Lorsque vous voulez utiliser un VPN assurez-vous que le client que vous utilisez est open
        source logiciel libre comme OpenVPN.</string>
    <string name="security_tips11">Quitter Ghost Messenger maintient vos données chiffrées sur votre
        téléphone.</string>
    <string name="security_tips12">Construisez Ghost Messenger depuis la source si possible.</string>
    <string name="security_tips13">Vérifiez les identités.</string>
    <string name="security_tips14">Assurez-vous de ne pas utiliser d\'applications propriétaires sur votre téléphone et
        que vous utilisez un programme open source gratuit pour accéder à vos sites de réseaux sociaux, services
        financiers, et généralement de ne pas avoir d\'application dont vous ne pouvez pas faire confiance ou une qui nécessite
        plus de permissions que nécessaire, ou présente des publicités de tiers présentées par
        l\'application elle-même.</string>
    <string name="security_tips15">Considérez faire une donation pour aider à rendre ce projet encore
        meilleur et nous aider à livrer la meilleure solution pour la messagerie anonyme à tous.</string>

    <string name="security_tips01">Sử dụng một bàn phím tôn trọng sự tự do của bạn và không
        kết nối với internet, chúng tôi khuyến nghị sử dụng OpenBoard</string>
    <string name="security_tips02">Bảo mật của bạn phụ thuộc nặng nề vào các ứng dụng
        được cài đặt trên thiết bị, chúng tôi khuyến nghị thay đổi ứng dụng mặc định của bạn thành các ứng dụng từ
        kho f-droid</string>
    <string name="security_tips03">Cố gắng không vô tình dán địa chỉ bạn bè của bạn vào trình duyệt của bạn vì điều đó có thể gây nguy hiểm cho bạn/đến sự ẩn danh của họ</string>
    <string name="security_tips04">Gỡ bỏ Anonymous Messenger để xóa tài khoản và xóa
        mọi thứ.</string>
    <string name="security_tips05">Tải xuống từ dịch vụ onion của chúng tôi an toàn hơn các
        máy chủ clear net của chúng tôi.</string>
    <string name="security_tips06">Bảo mật lưu trữ dữ liệu của bạn chỉ an toàn khi
        mật khẩu của bạn, chúng tôi khuyến nghị một mật khẩu dài được tạo từ các từ mà không có ý nghĩa nào đối với bạn.</string>
    <string name="security_tips07">Văn bản an toàn và ẩn danh hơn bất cứ điều gì khác.</string>
    <string name="security_tips08">Chia sẻ địa chỉ của bạn theo cách an toàn nhất có thể.</string>
    <string name="security_tips09">Nếu có thể, hãy mã hóa bộ nhớ điện thoại.</string>
    <string name="security_tips10">Khi bạn muốn sử dụng VPN hãy đảm bảo rằng khách hàng bạn sử dụng là mã nguồn mở phần mềm tự do như OpenVPN.</string>
    <string name="security_tips11">Thoát khỏi Anonymous Messenger giữ dữ liệu của bạn được mã hóa trên
        thiết bị của bạn.</string>
    <string name="security_tips12">Nếu có thể hãy xây dựng Anonymous Messenger từ nguồn.</string>
    <string name="security_tips13">Xác minh danh tính.</string>
    <string name="security_tips14">Đảm bảo rằng bạn không sử dụng bất kỳ ứng dụng sở hữu nào trên điện thoại của bạn và
        rằng bạn sử dụng một chương trình tự do mã nguồn mở để truy cập các trang web mạng xã hội của bạn, dịch vụ tài chính,
        và nói chung không có bất kỳ ứng dụng nào mà bạn không thể tin cậy hoặc một cái yêu cầu
